# Slack incoming webhook (from api.slack.com/apps → Incoming Webhooks)
SLACK_WEBHOOK_URL=your_slack_incoming_webhook_url

# Slack signing secret (from api.slack.com/apps → Basic Information → App Credentials)
SLACK_SIGNING_SECRET=your_signing_secret_here

# GitHub personal access token with repo read/write scope
# Create at github.com/settings/tokens → Fine-grained tokens
# Permissions needed: Contents (read + write)
GITHUB_TOKEN=github_pat_your_token_here

# Your GitHub repo in "owner/repo" format
GITHUB_REPO=your-username/lunch-bot

# How many restaurants to pick each day (default: 3)
PICKS_PER_DAY=3
